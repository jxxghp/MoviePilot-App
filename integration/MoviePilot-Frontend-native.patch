@@ -0,0 +1,34 @@
+/** 上传头像可能是较大的 data URI；仅为 App 转成有界缩略图，网页原头像保持不变。 */
+export async function nativeProfileAvatar(reference: string): Promise<string | undefined> {
+  if (!reference.startsWith('data:')) return reference
+  if (
+    reference.length > 1_200_000 ||
+    !/^data:image\/(?:png|jpeg|gif|webp|ico|x-icon);base64,[A-Za-z0-9+/]+=*$/u.test(reference)
+  )
+    return undefined
+  const image = new Image()
+  try {
+    image.src = reference
+    await image.decode()
+    if (!image.naturalWidth || !image.naturalHeight) return undefined
+    for (const size of [96, 64]) {
+      const canvas = document.createElement('canvas')
+      canvas.width = canvas.height = size
+      const context = canvas.getContext('2d')
+      if (!context) return undefined
+      context.fillStyle = '#ffffff'
+      context.fillRect(0, 0, size, size)
+      const scale = Math.max(size / image.naturalWidth, size / image.naturalHeight)
+      const width = image.naturalWidth * scale
+      const height = image.naturalHeight * scale
+      context.drawImage(image, (size - width) / 2, (size - height) / 2, width, height)
+      const thumbnail = canvas.toDataURL('image/jpeg', 0.8)
+      if (thumbnail.length <= 8192) return thumbnail
+    }
+  } catch {
+    // 头像失败只使用系统占位，不影响账号菜单或原网页图片。
+  } finally {
+    image.src = ''
+  }
+  return undefined
+}
diff --git a/src/native/protocol.ts b/src/native/protocol.ts
new file mode 100644
index 00000000..f6083568
--- /dev/null
+++ b/src/native/protocol.ts
@@ -0,0 +1,146 @@
+/** 原生导航只接收声明；业务回调不参与 JSON 序列化。 */
+export interface NativeAction {
+  actionId: string
+  ownerId: string
+  title: string
+  icon: string
+  position: 'leading' | 'trailing' | 'accessory'
+  /** 区分跨页面入口和当前页面操作；旧容器可以忽略。 */
+  scope?: 'global' | 'page'
+  enabled: boolean
+  loading: boolean
+  dataAttr?: string
+  menu?: Array<{ actionId: string; title: string; icon: string; enabled: boolean }>
+  panel?: NativePanel
+}
+
+/** 系统面板只接收展示数据和稳定标识，业务回调留在网页内。 */
+export interface NativePanelItem {
+  id: string
+  title: string
+  subtitle?: string
+  icon?: string
+  /** 通知等现有内容的图片地址，仅用于展示，不能作为导航或业务命令。 */
+  image?: string
+  enabled?: boolean
+  selected?: boolean
+  destructive?: boolean
+  keepOpen?: boolean
+  children?: NativePanelItem[]
+}
+
+/** 快捷入口共用系统列表与搜索控件，分组内容来自现有业务组件。 */
+export interface NativePanel {
+  title: string
+  subtitle?: string
+  profile?: { name: string; detail?: string; image?: string }
+  search?: { text: string; placeholder: string }
+  sections: Array<{ id: string; title?: string; items: NativePanelItem[] }>
+  loading?: boolean
+  hasMore?: boolean
+  emptyText?: string
+}
+
+/** 原生 Sheet 只搬运现有 WebView；标题栏命令限定到当前实际弹窗及其按钮。 */
+export interface NativeSheet {
+  id: string
+  title: string
+  fullscreen: boolean
+  canDismiss: boolean
+  /** 可选的底页准备握手；不提供时容器沿用直接接管流程。 */
+  backdropReady?: boolean
+  actions: Array<{ id: string; title: string; enabled: boolean }>
+}
+
+/** 已经经过网页权限过滤和路由守卫的完整原生显示状态。 */
+export interface NativeSnapshot {
+  route: { fullPath: string; rootId: string | null; title: string; canGoBack: boolean; backTarget?: string }
+  roots: Array<{ id: string; path: string; title: string; icon: string }>
+  headerTabs?: { ownerId: string; selectedId: string; items: Array<{ id: string; title: string }> }
+  actions: NativeAction[]
+  moreMenu?: NativeMenuSection[]
+  presentation?: { overlayOpen: boolean; fullscreen?: boolean; requestedPanel?: string; sheet?: NativeSheet }
+  chrome: {
+    topVisible: boolean
+    bottomVisible: boolean
+    theme: 'system' | 'light' | 'dark'
+    content?: 'web' | 'menu'
+    accentColor?: string
+    backgroundColor?: string
+    surfaceColor?: string
+  }
+}
+
+/** 原生更多页只呈现已授权的入口；实际目的地仍由 Vue Router 和业务守卫处理。 */
+export interface NativeMenuSection {
+  id: string
+  title: string
+  items: Array<{ id: string; path: string; title: string; icon: string; subtitle?: string }>
+}
+
+/** 系统 point 几何；网页通过实际 viewport 宽度换算 CSS 像素。 */
+export interface NativeLayout {
+  layoutRevision: number
+  viewportPoints: { width: number; height: number }
+  contentInsets: { top: number; left: number; bottom: number; right: number }
+  systemSafeArea: { top: number; left: number; bottom: number; right: number }
+  chromeOcclusion: { top: number; left: number; bottom: number; right: number }
+  keyboardOcclusion: number
+  consumedByNativeFrame: boolean
+}
+
+/** v1 消息外壳；会话仅用于隔离不同文档，不作为认证凭据。 */
+export interface NativeEnvelope {
+  protocol: 'moviepilot.chrome'
+  major: 1
+  type: string
+  requestId: string
+  sessionId?: string
+  routeRevision?: number
+  stateRevision?: number
+  payload: Record<string, unknown>
+}
+
+/** 由主文档开始时注入的最小 WebKit 传输门面。 */
+export interface NativeTransport {
+  transportVersion: 1
+  /** 可选原生快捷面板能力；旧容器仍使用原有 HTML 回调。 */
+  panelsVersion?: 1
+  /** 可选原生业务弹窗容器；未协商时完整保留网页弹窗。 */
+  sheetsVersion?: 1
+  /** 非敏感安装标识，仅用于退出当前账号时撤销对应通知绑定。 */
+  notificationInstallation?: string
+  /** 只发送 JSON 声明，不暴露任意原生方法。 */
+  postMessage(message: NativeEnvelope): void
+  /** 只通知宿主显示登录框架，不携带令牌或用户输入。 */
+  authenticationRequired?(): void
+}
+
+declare global {
+  interface Window {
+    /** 普通浏览器和 PWA 中不存在；存在也不代表已完成接管。 */
+    MoviePilotNative?: NativeTransport
+  }
+}
+
+/** 桥接对象必须是普通 JSON 对象，不能把 null 或数组当作消息。 */
+export function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+/** 关联标识保持与 Swift 相同的短 ASCII 范围。 */
+export function isNativeIdentifier(value: unknown): value is string {
+  return typeof value === 'string' && /^[\x21-\x7e]{1,128}$/.test(value)
+}
+
+/** 内部路由不接受绝对来源、反斜杠或控制字符。 */
+export function isNativeRoute(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.startsWith('/') &&
+    !value.startsWith('//') &&
+    !value.includes('\\') &&
+    !/[\p{Cc}\p{Cf}]/u.test(value) &&
+    new TextEncoder().encode(value).length <= 4096
+  )
+}
diff --git a/src/native/registry.ts b/src/native/registry.ts
new file mode 100644
index 00000000..5e9c97f8
--- /dev/null
+++ b/src/native/registry.ts
@@ -0,0 +1,56 @@
+import { onScopeDispose, ref, shallowRef, type MaybeRefOrGetter } from 'vue'
+import type { DynamicHeaderTabConfig } from '@/composables/useDynamicHeaderTab'
+import type { NativePanel, NativePanelItem } from './protocol'
+
+/** 面板项目保存本地回调；投影到原生时主动移除函数。 */
+export interface NativePanelEntry extends Omit<NativePanelItem, 'children'> {
+  children?: NativePanelEntry[]
+  /** 选择时执行当前业务组件已有的方法。 */
+  invoke?(): void | Promise<unknown>
+}
+
+/** 原生面板提供者复用组件状态，不单独请求另一套业务 API。 */
+export interface NativePanelSource extends Omit<NativePanel, 'sections'> {
+  sections: Array<{ id: string; title?: string; items: NativePanelEntry[] }>
+  /** 打开时刷新现有组件的数据。 */
+  onOpen?(): void | Promise<unknown>
+  /** 输入只更新组件原有搜索词。 */
+  onQuery?(text: string): void
+  /** 分页继续使用现有加载方法。 */
+  onLoadMore?(): void | Promise<unknown>
+}
+
+/** 保留原始回调的全局导航动作，不穿过原生桥接。
+ */
+export interface NativeGlobalAction {
+  id: string
+  title: MaybeRefOrGetter<string>
+  icon: string
+  dataAttr?: string
+  visible?: MaybeRefOrGetter<boolean>
+  panel?: () => NativePanelSource | undefined
+  /** 原生入口直接打开既有业务组件，不合成另一套页面。
+   */
+  invoke(): void
+}
+
+/** 带 owner 的页内标签共享注册；布局仍持有原有 inject/global API。
+ */
+export const nativeHeaderRegistration = ref<DynamicHeaderTabConfig | null>(null)
+/** 全局动作替换容器以便跨组件订阅，未接管时不影响原网页入口。
+ */
+export const nativeGlobalActions = shallowRef<ReadonlyMap<string, NativeGlobalAction>>(new Map())
+/** 通知深链接等网页入口可请求宿主打开当前原生面板。 */
+export const nativeRequestedPanel = ref<string>()
+
+/** 按组件作用域登记原回调；旧实例销毁不能注销新实例的同名动作。
+ */
+export function useNativeGlobalAction(action: NativeGlobalAction) {
+  nativeGlobalActions.value = new Map(nativeGlobalActions.value).set(action.id, action)
+  onScopeDispose(() => {
+    if (nativeGlobalActions.value.get(action.id) !== action) return
+    const next = new Map(nativeGlobalActions.value)
+    next.delete(action.id)
+    nativeGlobalActions.value = next
+  })
+}
diff --git a/src/native/session.ts b/src/native/session.ts
new file mode 100644
index 00000000..1b459dae
--- /dev/null
+++ b/src/native/session.ts
@@ -0,0 +1,268 @@
+import {
+  isNativeIdentifier,
+  isRecord,
+  type NativeEnvelope,
+  type NativeSnapshot,
+  type NativeTransport,
+} from './protocol'
+
+/** 桥接只操作导航声明及生命周期，所有业务操作由调用方回到既有回调。 */
+export interface NativeSessionOptions {
+  transport: NativeTransport
+  target: Window
+  /** 每次分派前读取当前状态，避免缓存权限或旧 owner。 */
+  readState(): { routeRevision: number; snapshot: NativeSnapshot }
+  /** 接管与释放使用同一个 DOM 提交入口。 */
+  setActive(active: boolean): void | Promise<void>
+  /** 校验并应用原生量测，失败时不能隐藏网页导航。 */
+  applyLayout(payload: Record<string, unknown>): void
+  /** 执行已复核的当前意图；确认仅表示分派，不等待业务网络完成。 */
+  execute(message: NativeEnvelope): boolean | Promise<boolean>
+  /** 通知现有网页生命周期管理器，不启动另一套后台时钟。 */
+  lifecycle(state: 'active' | 'inactive' | 'background'): void
+}
+
+/** 单主文档的事务桥；没有 WebKit 门面时不会创建此对象。 */
+export class NativeChromeSession {
+  private phase: 'web' | 'waiting' | 'configured' | 'preparing' | 'active' | 'closed' = 'web'
+  private sessionId?: string
+  private stateRevision = 0
+  private routeRevision = 0
+  private sequence = 0
+  private timer?: ReturnType<typeof setTimeout>
+  private runningCommands = 0
+  private readonly results = new Map<string, Promise<{ accepted: boolean; error?: string }>>()
+  private readonly completed = new Set<string>()
+  private readonly listener = (event: Event) => {
+    void this.receive((event as CustomEvent<unknown>).detail).catch(() => this.fail())
+  }
+
+  /** 所有外部能力通过窄接口注入，便于用真实 Router 和受控 DOM 验证。 */
+  constructor(private readonly options: NativeSessionOptions) {}
+
+  /** 网页仍显示完整导航，先协商双方版本与能力。 */
+  start() {
+    if (this.phase !== 'web') return
+    this.phase = 'waiting'
+    this.options.target.addEventListener('moviepilot:native-message', this.listener)
+    this.post('web.ready', {
+      majors: [1],
+      capabilities: ['navigation.v1', 'actions.v1', 'layout.v1', 'menu.v1', 'notifications.v1'],
+    })
+    this.timer = setTimeout(() => {
+      void this.fail()
+    }, 3000)
+  }
+
+  /** 使用全量状态且单调递增展示修订，不序列化回调或认证信息。 */
+  publish() {
+    if (!['configured', 'preparing', 'active'].includes(this.phase)) return
+    const { routeRevision, snapshot } = this.options.readState()
+    this.routeRevision = routeRevision
+    this.stateRevision += 1
+    this.post('navigation.state', snapshot as unknown as Record<string, unknown>)
+  }
+
+  /** 卸载时撤销 DOM 模式及全部回调引用，不能把旧 owner 留给下一布局。 */
+  async stop() {
+    clearTimeout(this.timer)
+    this.options.target.removeEventListener('moviepilot:native-message', this.listener)
+    this.phase = 'closed'
+    await this.options.setActive(false)
+    this.results.clear()
+    this.completed.clear()
+    this.sessionId = undefined
+  }
+
+  /** 当前认证或权限上下文变化时通知宿主清理旧命令，再发布新代次。 */
+  identityChanged() {
+    if (!this.sessionId) return
+    this.results.clear()
+    this.completed.clear()
+    this.post('session.state', { changed: true })
+  }
+
+  /** 当前页面注册超出协议表达范围时恢复完整网页导航。 */
+  fallback() {
+    void this.fail()
+  }
+
+  /** 只接受结构、大小、版本和当前会话均正确的封闭消息集合。 */
+  private async receive(value: unknown) {
+    if (
+      !isRecord(value) ||
+      (this.phase === 'closed' && value.type !== 'chrome.release') ||
+      value.protocol !== 'moviepilot.chrome' ||
+      value.major !== 1 ||
+      !isNativeIdentifier(value.requestId) ||
+      typeof value.type !== 'string' ||
+      !isRecord(value.payload) ||
+      new TextEncoder().encode(JSON.stringify(value)).length > 65536
+    )
+      return
+    const message = value as unknown as NativeEnvelope
+    if (message.type === 'host.configure') {
+      const capabilities = message.payload.capabilities
+      if (
+        this.phase !== 'waiting' ||
+        !isNativeIdentifier(message.sessionId) ||
+        message.payload.sessionId !== message.sessionId ||
+        message.payload.major !== 1 ||
+        !Array.isArray(capabilities) ||
+        !['navigation.v1', 'actions.v1', 'layout.v1', 'menu.v1'].every(capability => capabilities.includes(capability))
+      )
+        return
+      clearTimeout(this.timer)
+      this.sessionId = message.sessionId
+      this.phase = 'configured'
+      this.publish()
+      this.timer = setTimeout(() => {
+        void this.fail()
+      }, 3000)
+      return
+    }
+    if (!this.sessionId || message.sessionId !== this.sessionId) return
+    if (message.type === 'host.rekey') {
+      if (this.phase !== 'active' || !isNativeIdentifier(message.payload.sessionId)) {
+        await this.fail()
+        return
+      }
+      this.sessionId = message.payload.sessionId
+      this.stateRevision = 0
+      this.results.clear()
+      this.completed.clear()
+      this.publish()
+      return
+    }
+    if (message.type === 'chrome.release') {
+      this.phase = 'closed'
+      clearTimeout(this.timer)
+      await this.options.setActive(false)
+      this.post('chrome.released', {})
+      return
+    }
+    if (message.type === 'chrome.prepare') {
+      if (this.phase !== 'configured') return
+      this.options.applyLayout(message.payload)
+      this.phase = 'preparing'
+      await this.options.setActive(true)
+      if (this.phase !== 'preparing') {
+        await this.options.setActive(false)
+        return
+      }
+      this.phase = 'active'
+      clearTimeout(this.timer)
+      this.post('chrome.accepted', { layoutRevision: message.payload.layoutRevision })
+      return
+    }
+    if (message.type === 'host.layout' && this.phase === 'active') {
+      this.options.applyLayout(message.payload)
+      return
+    }
+    if (message.type === 'host.lifecycle') {
+      const state = message.payload.state
+      if (state === 'active' || state === 'inactive' || state === 'background') {
+        this.options.lifecycle(state)
+        clearTimeout(this.timer)
+        if (state === 'active' && ['configured', 'preparing'].includes(this.phase))
+          this.timer = setTimeout(() => {
+            void this.fail()
+          }, 3000)
+      }
+      return
+    }
+    if (
+      ![
+        'navigation.selectRoot',
+        'navigation.back',
+        'navigation.open',
+        'notification.open',
+        'headerTab.select',
+        'action.invoke',
+        'presentation.prepare',
+        'presentation.attach',
+        'presentation.detach',
+        'presentation.dismiss',
+        'presentation.action',
+        'state.request',
+      ].includes(message.type)
+    )
+      return
+    let result = this.results.get(message.requestId)
+    if (!result) {
+      if (this.runningCommands >= 16) {
+        this.post('command.result', { requestId: message.requestId, accepted: false, error: 'busy' })
+        return
+      }
+      this.runningCommands += 1
+      result = this.dispatch(message).finally(() => {
+        this.runningCommands -= 1
+      })
+      this.results.set(message.requestId, result)
+      // 只清理已经完成的旧结果，不移除尚未确认的命令来腾出并发槽。
+      void result.then(() => {
+        if (this.results.get(message.requestId) !== result) return
+        this.completed.add(message.requestId)
+        while (this.results.size > 256 && this.completed.size) {
+          const oldest = this.completed.values().next().value!
+          this.completed.delete(oldest)
+          this.results.delete(oldest)
+        }
+      })
+    }
+    const reply = await result
+    if (message.sessionId === this.sessionId && this.phase === 'active') {
+      this.post('command.result', { requestId: message.requestId, ...reply })
+      this.publish()
+    }
+  }
+
+  /** 分派前重新检查当前代次；重复 requestId 只返回第一次分派结果。 */
+  private async dispatch(message: NativeEnvelope) {
+    if (this.phase !== 'active') return { accepted: false, error: 'busy' }
+    try {
+      if (message.type !== 'state.request' && message.routeRevision !== this.options.readState().routeRevision)
+        return { accepted: false, error: 'stale_route' }
+      const accepted = message.type === 'state.request' || (await this.options.execute(message))
+      return accepted ? { accepted: true } : { accepted: false, error: 'action_not_available' }
+    } catch {
+      return { accepted: false, error: 'navigation_cancelled' }
+    }
+  }
+
+  /** 发送上限内 JSON；传输失败恢复网页并让原生执行释放事务。 */
+  private post(type: string, payload: Record<string, unknown>) {
+    const message: NativeEnvelope = {
+      protocol: 'moviepilot.chrome',
+      major: 1,
+      type,
+      requestId: `web-${++this.sequence}`,
+      payload,
+    }
+    if (this.sessionId) {
+      message.sessionId = this.sessionId
+      // 恢复通知也必须能在当前注册损坏时发送，元数据使用最后一次成功读取的路由代次。
+      message.routeRevision = this.routeRevision
+      message.stateRevision = this.stateRevision
+    }
+    const serialized = JSON.stringify(message)
+    if (new TextEncoder().encode(serialized).length > 65536) throw new Error('invalid_message')
+    // WK 消息只接收独立的标准 JSON 值，不能直接传 Vue Proxy 或后续仍会变化的响应式对象。
+    this.options.transport.postMessage(JSON.parse(serialized) as NativeEnvelope)
+  }
+
+  /** 只有仍可执行 JS 时才能恢复网页；宿主另行处理进程终止。 */
+  private async fail() {
+    if (this.phase === 'closed') return
+    this.phase = 'closed'
+    clearTimeout(this.timer)
+    await this.options.setActive(false)
+    if (this.sessionId) {
+      try {
+        this.post('chrome.failed', { reason: 'adapter_unavailable' })
+      } catch {
+        /* 宿主超时将显示恢复出口。 */
+      }
+    }
+  }
+}
diff --git a/src/native/sheet.ts b/src/native/sheet.ts
new file mode 100644
index 00000000..adca6803
--- /dev/null
+++ b/src/native/sheet.ts
@@ -0,0 +1,152 @@
+import type { NativeSheet } from './protocol'
+
+/** 投影真实 Vue 弹窗及标题栏，持有 DOM 引用而不复制内容、事件或认证状态。 */
+export class NativeSheetAdapter {
+  private sequence = 0
+  private ids = new WeakMap<Element, string>()
+  private buttonIds = new WeakMap<Element, string>()
+  private root?: HTMLElement
+  private close?: HTMLButtonElement
+  private buttons = new Map<string, HTMLButtonElement>()
+  private attached?: string
+  private prepared?: string
+
+  /** 作用域限定当前文档；关闭文档或降级时必须调用 reset 恢复原页面。 */
+  constructor(private document: Document) {}
+
+  /** 每次重新读取活动最上层，嵌套弹窗撤销旧按钮的执行权限。 */
+  read(fallbackTitle: string): NativeSheet | undefined {
+    const roots = Array.from(
+      this.document.querySelectorAll<HTMLElement>(
+        '.v-overlay--active.v-dialog, .theme-customizer-panel-host[role="dialog"], .agent-assistant-panel.is-open[role="dialog"]',
+      ),
+    )
+    const root = roots.sort((a, b) => this.zIndex(a) - this.zIndex(b)).at(-1)
+    this.root = root
+    this.buttons.clear()
+    this.close = undefined
+    if (!root) {
+      if (!this.attached) this.clearMarkers()
+      return
+    }
+    let id = this.ids.get(root)
+    if (!id) this.ids.set(root, (id = `sheet-${++this.sequence}`))
+    if (this.prepared && this.prepared !== id) this.clearPreparation()
+    this.close = root.querySelector<HTMLButtonElement>('[data-native-dialog-close]') ?? undefined
+    const header = root.querySelector<HTMLElement>(
+      '[data-native-dialog-header], .v-card-item, .v-toolbar, .theme-customizer-header, .agent-assistant-header, :scope > .v-overlay__content > .v-card > .v-card-title',
+    )
+    const heading =
+      root.querySelector('[data-native-dialog-title]') ??
+      (header?.matches('.v-card-title') ? header : undefined) ??
+      header?.querySelector('.v-card-title, .v-toolbar-title, .theme-customizer-title, .agent-assistant-title') ??
+      root.querySelector(':scope > .v-overlay__content > .v-card > .v-card-title')
+    heading?.setAttribute('data-native-sheet-heading', '')
+    const title = this.label(root.getAttribute('aria-label') || heading?.textContent || fallbackTitle)
+    const actions: NativeSheet['actions'] = []
+    if (header) {
+      header.setAttribute('data-native-sheet-header', '')
+      for (const button of header.querySelectorAll<HTMLButtonElement>('button')) {
+        if (button === this.close || button.closest('[aria-hidden="true"]')) continue
+        const title = this.label(
+          button.getAttribute('aria-label') || button.getAttribute('title') || button.textContent,
+        )
+        if (!title || actions.length >= 8) continue
+        let actionId = this.buttonIds.get(button)
+        if (!actionId) this.buttonIds.set(button, (actionId = `sheet-button-${++this.sequence}`))
+        actions.push({ id: actionId, title, enabled: !button.disabled })
+        this.buttons.set(actionId, button)
+      }
+      // 无法表达的标题栏控件继续留在内容中，避免删除插件自己的业务入口。
+      if (header.querySelector('input, select, textarea, [role="tablist"], [aria-haspopup="menu"], [aria-owns]')) {
+        header.removeAttribute('data-native-sheet-header')
+        actions.length = 0
+        this.buttons.clear()
+      }
+    }
+    if (this.attached) this.mark(root)
+    return {
+      id,
+      title: title || 'MoviePilot',
+      fullscreen:
+        root.classList.contains('v-dialog--fullscreen') ||
+        root.matches('.theme-customizer-panel-host, .agent-assistant-panel'),
+      canDismiss: Boolean(this.close && !this.close.disabled),
+      backdropReady: this.prepared === id,
+      actions,
+    }
+  }
+
+  /** 只执行当前弹窗的可见按钮；旧层、关闭后的 ID 与任意选择器均不可执行。 */
+  execute(type: string, payload: Record<string, unknown>) {
+    if (type === 'presentation.detach') {
+      if (payload.id !== this.attached) return false
+      this.reset()
+      return true
+    }
+    const root = this.root
+    if (!root?.isConnected || this.ids.get(root) !== payload.id) return false
+    if (type === 'presentation.prepare') {
+      if (this.attached) return false
+      this.prepared = payload.id as string
+      this.document.documentElement.setAttribute('data-native-sheet-preparing', '')
+      return true
+    }
+    if (type === 'presentation.attach') {
+      this.attached = payload.id as string
+      this.mark(root)
+      return true
+    }
+    const button = type === 'presentation.dismiss' ? this.close : this.buttons.get(String(payload.actionId))
+    if (!['presentation.dismiss', 'presentation.action'].includes(type) || !button?.isConnected || button.disabled)
+      return false
+    button.click()
+    return true
+  }
+
+  /** 宿主退出或协商失效时立即恢复原来的网页弹窗标题、背景和布局。 */
+  reset() {
+    this.attached = undefined
+    this.clearMarkers()
+    for (const header of this.document.querySelectorAll('[data-native-sheet-header]'))
+      header.removeAttribute('data-native-sheet-header')
+    for (const heading of this.document.querySelectorAll('[data-native-sheet-heading]'))
+      heading.removeAttribute('data-native-sheet-heading')
+  }
+
+  /** 标记只影响当前活动弹窗，菜单仍在同一文档中保留原有交互。 */
+  private mark(root: HTMLElement) {
+    this.clearPreparation()
+    for (const old of this.document.querySelectorAll('[data-native-sheet-current]'))
+      if (old !== root) old.removeAttribute('data-native-sheet-current')
+    root.setAttribute('data-native-sheet-current', '')
+    this.document.documentElement.setAttribute('data-native-sheet', '')
+  }
+
+  /** 清除容器标记不关闭 Vue 弹窗，也不触发业务回调。 */
+  private clearMarkers() {
+    this.clearPreparation()
+    this.document.documentElement.removeAttribute('data-native-sheet')
+    for (const root of this.document.querySelectorAll('[data-native-sheet-current]'))
+      root.removeAttribute('data-native-sheet-current')
+  }
+
+  /** 原生已保留底页或准备取消时恢复弹窗展示，不改变任何业务输入与回调。 */
+  private clearPreparation() {
+    this.prepared = undefined
+    this.document.documentElement.removeAttribute('data-native-sheet-preparing')
+  }
+
+  /** Vuetify 层级优先，未声明层级时保持文档中的后开弹窗在上。 */
+  private zIndex(element: HTMLElement) {
+    return Number.parseInt(this.document.defaultView?.getComputedStyle(element).zIndex || '0') || 0
+  }
+
+  /** 标题有界且没有控制字符，不能扩大桥接消息或成为原生命令。 */
+  private label(value: string | null | undefined) {
+    return (value || '')
+      .replace(/[\p{Cc}\p{Cf}]/gu, ' ')
+      .trim()
+      .slice(0, 100)
+  }
+}
diff --git a/src/pages/appcenter.vue b/src/pages/appcenter.vue
index 425504c4..ebc07643 100644
--- a/src/pages/appcenter.vue
+++ b/src/pages/appcenter.vue
@@ -7,6 +7,7 @@ import { filterPluginSidebarNavEntries } from '@/utils/pluginSidebarNav'
 import { buildUserPermissionContext, filterMenusByPermission } from '@/utils/permission'
 import { useDynamicButton } from '@/composables/useDynamicButton'
 import { usePWA } from '@/composables/usePWA'
