diff --git a/src/native/__tests__/session.spec.ts b/src/native/__tests__/session.spec.ts
new file mode 100644
index 00000000..eb0f1d6c
--- /dev/null
+++ b/src/native/__tests__/session.spec.ts
@@ -0,0 +1,272 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { flushPromises } from '@vue/test-utils'
+import { isProxy, reactive } from 'vue'
+import { NativeChromeSession, type NativeSessionOptions } from '../session'
+import type { NativeEnvelope, NativeSnapshot } from '../protocol'
+
+const snapshot: NativeSnapshot = {
+  route: { fullPath: '/apps', rootId: '/apps', title: '更多', canGoBack: false },
+  roots: [{ id: '/apps', path: '/apps', title: '更多', icon: 'apps' }],
+  actions: [],
+  chrome: { topVisible: true, bottomVisible: true, theme: 'system' },
+}
+const cleanups: Array<() => Promise<void>> = []
+
+/** 用宿主固定入口发送消息，不越过会话的实际事件监听路径。 */
+async function send(type: string, payload: Record<string, unknown> = {}, extra: Partial<NativeEnvelope> = {}) {
+  window.dispatchEvent(
+    new CustomEvent('moviepilot:native-message', {
+      detail: {
+        protocol: 'moviepilot.chrome',
+        major: 1,
+        type,
+        requestId: 'native-1',
+        sessionId: 'session-1',
+        routeRevision: 1,
+        payload,
+        ...extra,
+      },
+    }),
+  )
+  await flushPromises()
+}
+
+/** 每个测试拥有独立回调和文档会话，便于验证重复分派与权限代次变化。 */
+function harness(overrides: Partial<NativeSessionOptions> = {}) {
+  const messages: NativeEnvelope[] = []
+  const options: NativeSessionOptions = {
+    target: window,
+    transport: { transportVersion: 1, postMessage: message => messages.push(message) },
+    readState: () => ({ routeRevision: 1, snapshot }),
+    setActive: vi.fn(),
+    applyLayout: vi.fn(),
+    execute: vi.fn(() => true),
+    lifecycle: vi.fn(),
+    ...overrides,
+  }
+  const session = new NativeChromeSession(options)
+  cleanups.push(() => session.stop())
+  session.start()
+  return { session, options, messages }
+}
+
+/** 宿主协商和布局确认都必须经事件入口完成。 */
+async function activate() {
+  await send('host.configure', {
+    sessionId: 'session-1',
+    major: 1,
+    capabilities: ['navigation.v1', 'actions.v1', 'layout.v1', 'menu.v1'],
+  })
+  await send('chrome.prepare', { layoutRevision: 7 })
+}
+
+afterEach(async () => {
+  for (const cleanup of cleanups.splice(0)) await cleanup()
+})
+
+describe('原生导航接管事务', () => {
+  it('离页只等待支持预览的新容器，确认必须属于当前会话且不执行任何业务命令', async () => {
+    const legacy = harness()
+    await activate()
+    await legacy.session.prepareNavigation()
+    expect(legacy.messages.some(message => message.type === 'navigation.departing')).toBe(false)
+    await legacy.session.stop()
+    const messages: NativeEnvelope[] = []
+    const { session, options } = harness({
+      transport: { transportVersion: 1, navigationPreviewVersion: 1, postMessage: message => messages.push(message) },
+    })
+    await activate()
+    const done = vi.fn()
+    const pending = session.prepareNavigation().then(done)
+    const request = messages.find(message => message.type === 'navigation.departing')!
+    expect(request.routeRevision).toBe(1)
+    await send('navigation.previewed', request.payload, { sessionId: 'old-session' })
+    expect(done).not.toHaveBeenCalled()
+    await send('navigation.previewed', request.payload)
+    await pending
+    expect(done).toHaveBeenCalledOnce()
+    expect(options.execute).not.toHaveBeenCalled()
+    const changed = session.prepareNavigation()
+    session.identityChanged()
+    await changed
+  })
+
+  it('预览确认丢失时有界放行路由，停止会话也不遗留等待', async () => {
+    const { session } = harness({
+      transport: { transportVersion: 1, navigationPreviewVersion: 1, postMessage: vi.fn() },
+    })
+    await activate()
+    vi.useFakeTimers()
+    try {
+      const done = vi.fn()
+      const pending = session.prepareNavigation().then(done)
+      await vi.advanceTimersByTimeAsync(151)
+      await pending
+      expect(done).toHaveBeenCalledOnce()
+      const stopped = session.prepareNavigation()
+      await session.stop()
+      await stopped
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+
+  it('展示快照脱离 Vue 代理，传输后修改原状态不会改变已经交付的消息', async () => {
+    const source = reactive<NativeSnapshot>({
+      ...snapshot,
+      presentation: {
+        overlayOpen: true,
+        sheet: { id: 'sheet-1', title: '名称识别', fullscreen: false, canDismiss: true, actions: [] },
+      },
+    })
+    const { messages } = harness({ readState: () => ({ routeRevision: 1, snapshot: source }) })
+    await activate()
+    const delivered = messages.find(message => message.type === 'navigation.state')!
+    expect(isProxy(delivered.payload)).toBe(false)
+    const presentation = delivered.payload.presentation as NativeSnapshot['presentation']
+    expect(isProxy(presentation?.sheet)).toBe(false)
+    source.presentation!.sheet!.title = '后续弹窗'
+    expect(presentation?.sheet?.title).toBe('名称识别')
+  })
+
+  it('先保留网页，只有完整配置与布局确认后才提交接管', async () => {
+    const { options, messages } = harness()
+    expect(messages[0].type).toBe('web.ready')
+    expect(options.setActive).not.toHaveBeenCalled()
+    await send('chrome.prepare', { layoutRevision: 1 })
+    expect(options.setActive).not.toHaveBeenCalled()
+    await activate()
+    expect(messages.map(message => message.type)).toEqual(['web.ready', 'navigation.state', 'chrome.accepted'])
+    expect(options.applyLayout).toHaveBeenCalledBefore(options.setActive as ReturnType<typeof vi.fn>)
+    expect(options.setActive).toHaveBeenCalledWith(true)
+    expect(messages.at(-1)?.payload.layoutRevision).toBe(7)
+  })
+
+  it('过期会话和过期路由不能执行动作，重复请求只分派一次', async () => {
+    const { options, messages } = harness()
+    await activate()
+    await send('action.invoke', {}, { sessionId: 'old' })
+    await send('action.invoke', {}, { routeRevision: 0, requestId: 'old-route' })
+    expect(options.execute).not.toHaveBeenCalled()
+    expect(messages.find(message => message.payload.requestId === 'old-route')?.payload.error).toBe('stale_route')
+    await send('action.invoke', {}, { requestId: 'once' })
+    await send('action.invoke', {}, { requestId: 'once' })
+    expect(options.execute).toHaveBeenCalledTimes(1)
+    expect(
+      messages.filter(message => message.type === 'command.result' && message.payload.requestId === 'once'),
+    ).toHaveLength(2)
+  })
+
+  it('仍在等待回调的重复命令也不会重复分派', async () => {
+    let finish!: (value: boolean) => void
+    const { options } = harness({
+      execute: vi.fn(
+        () =>
+          new Promise<boolean>(resolve => {
+            finish = resolve
+          }),
+      ),
+    })
+    await activate()
+    await send('action.invoke', {}, { requestId: 'waiting' })
+    await send('action.invoke', {}, { requestId: 'waiting' })
+    expect(options.execute).toHaveBeenCalledTimes(1)
+    finish(true)
+    await flushPromises()
+  })
+
+  it('结果缓存周转不会驱逐仍在执行的请求并重复分派', async () => {
+    let finish!: (value: boolean) => void
+    const execute = vi.fn((message: NativeEnvelope) =>
+      message.requestId === 'waiting'
+        ? new Promise<boolean>(resolve => {
+            finish = resolve
+          })
+        : true,
+    )
+    harness({ execute })
+    await activate()
+    await send('action.invoke', {}, { requestId: 'waiting' })
+    for (let index = 0; index < 260; index++) await send('action.invoke', {}, { requestId: `finished-${index}` })
+    await send('action.invoke', {}, { requestId: 'waiting' })
+    expect(execute.mock.calls.filter(([message]) => message.requestId === 'waiting')).toHaveLength(1)
+    finish(true)
+    await flushPromises()
+  })
+
+  it('恢复网页 DOM 完成后才确认释放，之后命令失效', async () => {
+    const { options, messages } = harness()
+    await activate()
+    await send('chrome.release')
+    expect(options.setActive).toHaveBeenLastCalledWith(false)
+    expect(messages.at(-1)?.type).toBe('chrome.released')
+    await send('action.invoke')
+    expect(options.execute).not.toHaveBeenCalled()
+  })
+
+  it('失配能力或布局错误保持网页模式', async () => {
+    const { options } = harness({
+      applyLayout: () => {
+        throw new Error('invalid')
+      },
+    })
+    await send('host.configure', { sessionId: 'session-1', major: 1, capabilities: [] })
+    expect(options.setActive).not.toHaveBeenCalled()
+    await activate()
+    expect(options.setActive).not.toHaveBeenCalledWith(true)
+    expect(options.setActive).toHaveBeenCalledWith(false)
+  })
+
+  it('准备与释放交错时不会迟到接管', async () => {
+    let finish!: () => void
+    const { messages } = harness({
+      setActive: value =>
+        value
+          ? new Promise<void>(resolve => {
+              finish = resolve
+            })
+          : undefined,
+    })
+    await send('host.configure', {
+      sessionId: 'session-1',
+      major: 1,
+      capabilities: ['navigation.v1', 'actions.v1', 'layout.v1', 'menu.v1'],
+    })
+    await send('chrome.prepare', { layoutRevision: 7 })
+    await send('chrome.release')
+    finish()
+    await flushPromises()
+    expect(messages.some(message => message.type === 'chrome.accepted')).toBe(false)
+  })
+
+  it('身份轮换后拒绝旧文档关联，并能从适配失败中确认恢复网页', async () => {
+    const { session, options, messages } = harness()
+    await activate()
+    session.identityChanged()
+    expect(messages.at(-1)?.type).toBe('session.state')
+    await send('host.rekey', { sessionId: 'session-2' })
+    expect(messages.at(-1)?.sessionId).toBe('session-2')
+    await send('action.invoke', {}, { requestId: 'old-user' })
+    expect(options.execute).not.toHaveBeenCalled()
+    session.fallback()
+    await flushPromises()
+    expect(messages.at(-1)?.type).toBe('chrome.failed')
+    await send('chrome.release', {}, { sessionId: 'session-2' })
+    expect(messages.at(-1)?.type).toBe('chrome.released')
+  })
+
+  it('当前注册无法形成快照时撤销接管且不执行命令，不遗留未处理的结果拒绝', async () => {
+    const { options, messages } = harness()
+    await activate()
+    options.readState = () => {
+      throw new Error('unsupported_header_registration')
+    }
+    await send('action.invoke', {}, { requestId: 'broken-registration' })
+    expect(options.execute).not.toHaveBeenCalled()
+    expect(options.setActive).toHaveBeenLastCalledWith(false)
+    expect(messages.at(-1)?.type).toBe('chrome.failed')
+    expect(messages.at(-1)?.routeRevision).toBe(1)
+    await send('chrome.release')
+    expect(messages.at(-1)?.type).toBe('chrome.released')
+  })
+})
diff --git a/src/native/__tests__/sheet.spec.ts b/src/native/__tests__/sheet.spec.ts
new file mode 100644
index 00000000..f97c0554
--- /dev/null
+++ b/src/native/__tests__/sheet.spec.ts
@@ -0,0 +1,216 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { NativeSheetAdapter } from '../sheet'
+
+/** 用实际按钮验证只转移展示职责，既有监听器与输入值始终保留。 */
+function dialog(title: string, z = 2000) {
+  const root = document.createElement('div')
+  root.className = 'v-overlay--active v-dialog'
+  root.style.zIndex = String(z)
+  root.innerHTML = `<div class="v-overlay__content"><div class="v-card"><div class="v-card-item"><div class="v-card-title"></div><button data-native-dialog-close>关闭</button><button aria-label="刷新">刷新</button></div><input value="尚未保存" /></div></div>`
+  root.querySelector('.v-card-title')!.textContent = title
+  document.body.append(root)
+  return root
+}
+
+afterEach(() => {
+  vi.restoreAllMocks()
+  document.body.innerHTML = ''
+  document.documentElement.removeAttribute('data-native-sheet')
+  document.documentElement.removeAttribute('data-native-sheet-preparing')
+  document.documentElement.removeAttribute('data-native-sheets')
+})
+
+describe('原生 Sheet 与原 Vue 内容交接', () => {
+  it('能力标记只在明确接管时启用，打开和归还均等待两次绘制机会才确认', async () => {
+    const frames: FrameRequestCallback[] = []
+    vi.spyOn(window, 'requestAnimationFrame').mockImplementation(callback => frames.push(callback))
+    const root = dialog('名称识别')
+    const adapter = new NativeSheetAdapter(document)
+    const sheet = adapter.read('页面')!
+    expect(document.documentElement.hasAttribute('data-native-sheets')).toBe(false)
+    adapter.setActive(true)
+    expect(document.documentElement.getAttribute('data-native-sheets')).toBe('active')
+    const done = vi.fn()
+    const attach = adapter.executeWhenPainted('presentation.attach', { id: sheet.id }).then(done)
+    expect(done).not.toHaveBeenCalled()
+    frames.shift()!(0)
+    await Promise.resolve()
+    expect(done).not.toHaveBeenCalled()
+    frames.shift()!(16)
+    await attach
+    expect(done).toHaveBeenCalledExactlyOnceWith(true)
+    expect(root.querySelector('input')!.value).toBe('尚未保存')
+    const detached = vi.fn()
+    const detach = adapter.executeWhenPainted('presentation.detach', { id: sheet.id }).then(detached)
+    expect(document.documentElement.hasAttribute('data-native-sheet')).toBe(false)
+    expect(detached).not.toHaveBeenCalled()
+    frames.shift()!(32)
+    frames.shift()!(48)
+    await detach
+    expect(detached).toHaveBeenCalledExactlyOnceWith(true)
+    adapter.setActive(false)
+    expect(document.documentElement.hasAttribute('data-native-sheets')).toBe(false)
+  })
+
+  it.each(['关闭根', '切换根', '退出宿主'])('绘制期间%s不能迟到确认原弹窗', async operation => {
+    const frames: FrameRequestCallback[] = []
+    vi.spyOn(window, 'requestAnimationFrame').mockImplementation(callback => frames.push(callback))
+    const root = dialog('父弹窗')
+    const adapter = new NativeSheetAdapter(document)
+    const sheet = adapter.read('页面')!
+    const waiting = adapter.executeWhenPainted('presentation.attach', { id: sheet.id })
+    if (operation === '关闭根') root.remove()
+    if (operation === '切换根') {
+      dialog('子弹窗', 2100)
+      adapter.read('页面')
+    }
+    if (operation === '退出宿主') adapter.setActive(false)
+    frames.shift()!(0)
+    frames.shift()!(16)
+    expect(await waiting).toBe(false)
+  })
+
+  it('底页准备只响应当前原生请求，不触发业务按钮，接管或取消后立即清理', () => {
+    const root = dialog('名称识别')
+    const closed = vi.fn()
+    root.querySelector('[data-native-dialog-close]')!.addEventListener('click', closed)
+    const adapter = new NativeSheetAdapter(document)
+    const first = adapter.read('页面')!
+    expect(first.backdropReady).toBe(false)
+    expect(document.documentElement.hasAttribute('data-native-sheet-preparing')).toBe(false)
+    expect(adapter.execute('presentation.prepare', { id: 'stale' })).toBe(false)
+    expect(adapter.execute('presentation.prepare', { id: first.id })).toBe(true)
+    expect(adapter.read('页面')!.backdropReady).toBe(true)
+    expect(document.documentElement.hasAttribute('data-native-sheet-preparing')).toBe(true)
+    expect(root.querySelector('input')!.value).toBe('尚未保存')
+    expect(closed).not.toHaveBeenCalled()
+    adapter.execute('presentation.attach', { id: first.id })
+    expect(document.documentElement.hasAttribute('data-native-sheet-preparing')).toBe(false)
+    expect(adapter.execute('presentation.prepare', { id: first.id })).toBe(false)
+    adapter.reset()
+    adapter.execute('presentation.prepare', { id: first.id })
+    root.remove()
+    expect(adapter.read('页面')).toBeUndefined()
+    expect(document.documentElement.hasAttribute('data-native-sheet-preparing')).toBe(false)
+  })
+
+  it('准备期间更换弹窗撤销旧层准备，迟到请求不能隐藏新弹窗', () => {
+    dialog('父弹窗')
+    const adapter = new NativeSheetAdapter(document)
+    const first = adapter.read('页面')!
+    adapter.execute('presentation.prepare', { id: first.id })
+    dialog('子弹窗', 2100)
+    const next = adapter.read('页面')!
+    expect(next.backdropReady).toBe(false)
+    expect(document.documentElement.hasAttribute('data-native-sheet-preparing')).toBe(false)
+    expect(adapter.execute('presentation.prepare', { id: first.id })).toBe(false)
+    adapter.execute('presentation.prepare', { id: next.id })
+    adapter.reset()
+    expect(document.documentElement.hasAttribute('data-native-sheet-preparing')).toBe(false)
+  })
+
+  it('工具栏和声明式自定义标题使用同一原生栏，原按钮仍是唯一动作来源', () => {
+    const root = dialog('旧标题')
+    root.innerHTML =
+      '<div class="v-overlay__content"><div class="v-card"><header class="v-toolbar"><h2 class="v-toolbar-title">工作流</h2><button data-native-dialog-close>关闭</button><button aria-label="导入">导入</button></header></div></div>'
+    const adapter = new NativeSheetAdapter(document)
+    expect(adapter.read('页面')).toMatchObject({ title: '工作流', canDismiss: true, actions: [{ title: '导入' }] })
+    root.innerHTML =
+      '<div data-native-dialog-header><h3 data-native-dialog-title>分类</h3><button data-native-dialog-close>取消</button><button aria-label="保存">保存</button></div>'
+    expect(adapter.read('页面')).toMatchObject({ title: '分类', canDismiss: true, actions: [{ title: '保存' }] })
+  })
+
+  it('协商接管前不改变网页；接管后只发出原按钮事件并保留表单', () => {
+    const root = dialog('名称识别')
+    const closed = vi.fn(),
+      refreshed = vi.fn()
+    root.querySelector('[data-native-dialog-close]')!.addEventListener('click', closed)
+    root.querySelector('[aria-label="刷新"]')!.addEventListener('click', refreshed)
+    const adapter = new NativeSheetAdapter(document)
+    const state = adapter.read('页面')!
+    expect(state.title).toBe('名称识别')
+    expect(state.canDismiss).toBe(true)
+    expect(document.documentElement.hasAttribute('data-native-sheet')).toBe(false)
+    expect(adapter.execute('presentation.attach', { id: state.id })).toBe(true)
+    expect(root.hasAttribute('data-native-sheet-current')).toBe(true)
+    expect(adapter.execute('presentation.action', { id: state.id, actionId: state.actions[0].id })).toBe(true)
+    expect(adapter.execute('presentation.dismiss', { id: state.id })).toBe(true)
+    expect(refreshed).toHaveBeenCalledOnce()
+    expect(closed).toHaveBeenCalledOnce()
+    expect(root.querySelector('input')!.value).toBe('尚未保存')
+    expect(adapter.execute('presentation.detach', { id: state.id })).toBe(true)
+    expect(document.documentElement.hasAttribute('data-native-sheet')).toBe(false)
+    expect(root.querySelector('[data-native-sheet-header]')).toBeNull()
+  })
+
+  it('嵌套弹窗拒绝旧层关闭，关闭子层后恢复父层内容和身份', () => {
+    const parent = dialog('父弹窗')
+    const adapter = new NativeSheetAdapter(document)
+    const first = adapter.read('页面')!
+    adapter.execute('presentation.attach', { id: first.id })
+    const child = dialog('子弹窗', 2100)
+    const second = adapter.read('页面')!
+    expect(second.id).not.toBe(first.id)
+    expect(adapter.execute('presentation.dismiss', { id: first.id })).toBe(false)
+    expect(child.hasAttribute('data-native-sheet-current')).toBe(true)
+    child.remove()
+    expect(adapter.read('页面')!.id).toBe(first.id)
+    expect(parent.hasAttribute('data-native-sheet-current')).toBe(true)
+  })
+
+  it('按钮替换、禁用和不可关闭弹窗不会绕过当前业务状态', () => {
+    const root = dialog('持久进度')
+    const adapter = new NativeSheetAdapter(document)
+    const old = adapter.read('页面')!
+    root.querySelector('[data-native-dialog-close]')!.remove()
+    root.querySelector('[aria-label="刷新"]')!.outerHTML = '<button aria-label="保存">保存</button>'
+    const current = adapter.read('页面')!
+    expect(current.canDismiss).toBe(false)
+    expect(adapter.execute('presentation.dismiss', { id: current.id })).toBe(false)
+    expect(adapter.execute('presentation.action', { id: current.id, actionId: old.actions[0].id })).toBe(false)
+    root.querySelector('button')!.disabled = true
+    expect(adapter.execute('presentation.action', { id: current.id, actionId: current.actions[0].id })).toBe(false)
+    root.remove()
+    adapter.read('页面')
+    expect(adapter.execute('presentation.attach', { id: current.id })).toBe(false)
+  })
+
+  it('主题面板声明半屏时保留原生标题和关闭职责，不声明网页全屏', () => {
+    const root = document.createElement('aside')
+    root.className = 'theme-customizer-panel-host'
+    root.setAttribute('role', 'dialog')
+    root.setAttribute('aria-label', '主题定制')
+    root.innerHTML =
+      '<header class="theme-customizer-header"><h2 class="theme-customizer-title">主题定制</h2><button data-native-dialog-close>关闭</button></header><button>Blue</button>'
+    document.body.append(root)
+    const adapter = new NativeSheetAdapter(document)
+    expect(adapter.read('页面')).toMatchObject({ title: '主题定制', fullscreen: true, canDismiss: true })
+    root.dataset.nativeSheetSize = 'medium'
+    expect(adapter.read('页面')).toMatchObject({
+      title: '主题定制',
+      fullscreen: false,
+      canDismiss: true,
+      prefersMediumDetent: true,
+    })
+  })
+
+  it('助手只接管打开的面板，保留菜单的实际锚点并移走标题和关闭按钮', () => {
+    const root = document.createElement('aside')
+    root.className = 'agent-assistant-panel'
+    root.setAttribute('role', 'dialog')
+    root.setAttribute('aria-label', '助手')
+    root.innerHTML =
+      '<header class="agent-assistant-header"><div class="agent-assistant-title">助手</div><button aria-haspopup="menu" aria-label="历史">历史</button><button data-native-dialog-close>关闭</button></header><textarea>草稿</textarea>'
+    document.body.append(root)
+    const adapter = new NativeSheetAdapter(document)
+    expect(adapter.read('页面')).toBeUndefined()
+    root.classList.add('is-open')
+    const state = adapter.read('页面')!
+    expect(state).toMatchObject({ title: '助手', fullscreen: true, canDismiss: true, actions: [] })
+    expect(root.querySelector('[data-native-sheet-header]')).toBeNull()
+    expect(root.querySelector('[data-native-sheet-heading]')).not.toBeNull()
+    adapter.execute('presentation.attach', { id: state.id })
+    expect(root.querySelector('[aria-haspopup="menu"]')).not.toBeNull()
+    expect(root.querySelector('textarea')!.value).toBe('草稿')
+  })
+})
diff --git a/src/native/confirmation.ts b/src/native/confirmation.ts
new file mode 100644
index 00000000..ade134f6
--- /dev/null
+++ b/src/native/confirmation.ts
@@ -0,0 +1,81 @@
+import type { NativeConfirmation } from './protocol'
+
+/** 确认框只投影纯文字与当前按钮标识；Vue 组件继续拥有 Promise 和业务回调。 */
+export class NativeConfirmationAdapter {
+  private sequence = 0
+  private ids = new WeakMap<Element, string>()
+  private answered = new WeakSet<Element>()
+  private active = false
+
+  /** 每个适配器只读取当前主文档，不能查找其他 frame 或实例。 */
+  constructor(private document: Document) {}
+
+  /** 可选能力协商成功后才隐藏网页确认框；释放时原 DOM 自动恢复可操作。 */
+  setActive(active: boolean) {
+    this.active = active
+    if (active) this.document.documentElement.setAttribute('data-native-confirmations', 'active')
+    else this.document.documentElement.removeAttribute('data-native-confirmations')
+  }
+
+  /** 只读取最上层声明过的确认框，保留换行并限制桥接文字总量。 */
+  read(): NativeConfirmation | undefined {
+    const root = this.current()
+    if (!root) return
+    const confirm = root.querySelector<HTMLButtonElement>('[data-native-confirm-accept]')
+    const cancel = root.querySelector<HTMLButtonElement>('[data-native-confirm-cancel]')
+    if (!confirm || !cancel) return
+    let id = this.ids.get(root)
+    if (!id) this.ids.set(root, (id = `confirmation-${++this.sequence}`))
+    return {
+      id,
+      title: this.text(root.querySelector('[data-native-confirm-title]')?.textContent, 512) || 'MoviePilot',
+      message: this.text(root.querySelector('[data-native-confirm-message]')?.textContent, 8192, true),
+      confirmText: this.text(confirm.textContent, 512) || '确认',
+      cancelText: this.text(cancel.textContent, 512) || '取消',
+      confirmEnabled: !confirm.disabled,
+      cancelEnabled: !cancel.disabled,
+      destructive: root.getAttribute('data-native-confirm-kind') === 'error',
+    }
+  }
+
+  /** 最上层、身份与按钮可用性再次核验；重复或迟到命令不能执行已完成的业务。 */
+  respond(payload: Record<string, unknown>): boolean {
+    const root = this.current()
+    if (!root || this.ids.get(root) !== payload.id || typeof payload.confirmed !== 'boolean') return false
+    const button = root.querySelector<HTMLButtonElement>(
+      payload.confirmed ? '[data-native-confirm-accept]' : '[data-native-confirm-cancel]',
+    )
+    if (!button?.isConnected || button.disabled) return false
+    this.answered.add(root)
+    button.click()
+    return true
+  }
+
+  /** 其他弹窗覆盖时不允许穿透确认；关闭子层后才能恢复父层确认。 */
+  private current(): HTMLElement | undefined {
+    if (!this.active) return
+    const roots = [...this.document.querySelectorAll<HTMLElement>('.v-overlay--active.v-dialog')]
+    const root = roots.sort((a, b) => this.zIndex(a) - this.zIndex(b)).at(-1)
+    return root?.hasAttribute('data-native-confirm-dialog') && !this.answered.has(root) ? root : undefined
+  }
+
+  /** 与 Vuetify 实际层级一致，同层级采用文档顺序。 */
+  private zIndex(root: HTMLElement): number {
+    return Number.parseInt(this.document.defaultView?.getComputedStyle(root).zIndex || '0') || 0
+  }
+
+  /** 文案仅作为系统 label/message，不接受 HTML、脚本或控制字符。 */
+  private text(value: string | null | undefined, maximum: number, multiline = false): string {
+    let result = ''
+    let bytes = 0
+    const encoder = new TextEncoder()
+    for (const character of (value || '')
+      .replace(/[\p{Cc}\p{Cf}]/gu, character => (multiline && /[\n\r\t]/u.test(character) ? character : ' '))
+      .trim()) {
+      bytes += encoder.encode(character).length
+      if (bytes > maximum) break
+      result += character
+    }
+    return result
+  }
+}
