index 00000000..3fc2b9e4
--- /dev/null
+++ b/src/native/__tests__/header.spec.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest'
+import { NativeHeaderTabs } from '../header'
+import { isNativeIdentifier } from '../protocol'
+
+describe('原生页内分类和业务值交接', () => {
+  it('中文分类以稳定短标识跨桥，选择后解析回原来的业务值', () => {
+    const adapter = new NativeHeaderTabs()
+    const items = [
+      { tab: '全部', title: '全部' },
+      { tab: '电影', title: '电影' },
+    ]
+    const first = adapter.project('recommend', items, '全部')!
+    expect(first.items.every(item => isNativeIdentifier(item.id))).toBe(true)
+    expect(adapter.resolve('recommend', first.selectedId)).toBe('全部')
+    const second = adapter.project('recommend', [...items].reverse(), '电影')!
+    expect(second.items.find(item => item.title === '全部')?.id).toBe(first.selectedId)
+    expect(adapter.resolve('recommend', second.selectedId)).toBe('电影')
+  })
+
+  it('权限移除的分类和旧 owner 不能通过旧标识选择新项目', () => {
+    const adapter = new NativeHeaderTabs()
+    const first = adapter.project('page-a', [{ tab: '旧分类', title: '旧分类' }], '旧分类')!
+    const second = adapter.project('page-a', [{ tab: '新分类', title: '新分类' }], '新分类')!
+    expect(second.selectedId).not.toBe(first.selectedId)
+    expect(adapter.resolve('page-a', first.selectedId)).toBeUndefined()
+    adapter.project('page-b', [{ tab: '其他页面', title: '其他页面' }], '其他页面')
+    expect(adapter.resolve('page-a', second.selectedId)).toBeUndefined()
+  })
+
+  it('页面尚未确定默认分类时暂不呈现，业务初始化后再发布实际选择', () => {
+    const adapter = new NativeHeaderTabs()
+    const items = [{ tab: 'mysub', title: '我的订阅' }]
+    expect(adapter.project('subscribe', items, '')).toBeUndefined()
+    const actual = adapter.project('subscribe', items, 'mysub')!
+    expect(adapter.resolve('subscribe', actual.selectedId)).toBe('mysub')
+  })
+
+  it('重复业务值无法形成可确认的原生选择，应当回退', () => {
+    const adapter = new NativeHeaderTabs()
+    expect(() =>
+      adapter.project(
+        'page',
+        [
+          { tab: 'a', title: 'A' },
+          { tab: 'a', title: 'B' },
+        ],
+        'a',
+      ),
+    ).toThrow()
+  })
+})
diff --git a/src/native/__tests__/history.spec.ts b/src/native/__tests__/history.spec.ts
new file mode 100644
index 00000000..41ec7dac
--- /dev/null
+++ b/src/native/__tests__/history.spec.ts
@@ -0,0 +1,92 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import { createRouter, createWebHashHistory, type Router } from 'vue-router'
+import { flushPromises } from '@vue/test-utils'
+import { NativeRouteHistory } from '../history'
+
+const roots = [
+  { id: '/dashboard', path: '/dashboard', title: '首页', icon: 'dashboard' },
+  { id: '/apps', path: '/apps', title: '更多', icon: 'apps' },
+]
+const cleanups: Array<() => void> = []
+
+/** 使用真实 hash Router，确保不是只验证一份自制栈的实现镜像。 */
+async function harness() {
+  window.history.replaceState(null, '', '/#/dashboard')
+  const router = createRouter({
+    history: createWebHashHistory(),
+    routes: [{ path: '/:pathMatch(.*)*', component: { template: '<div />' }, meta: { requiresAuth: true } }],
+  })
+  await router.push('/dashboard')
+  const history = new NativeRouteHistory(router, () => roots)
+  cleanups.push(() => {
+    history.stop()
+    router.options.history.destroy()
+  })
+  return { router, history }
+}
+
+/** 在触发浏览器 pop 前先订阅完成事件，避免依赖不确定延迟。
+ */
+function navigateOnce(router: Router, action: () => void) {
+  return new Promise<void>(resolve => {
+    const remove = router.afterEach(() => {
+      remove()
+      resolve()
+    })
+    action()
+  })
+}
+
+afterEach(() => {
+  for (const cleanup of cleanups.splice(0)) cleanup()
+})
+
+describe('网页业务路由是导航事实来源', () => {
+  it('push/replace/pop 与 Tab 恢复均不要求重建文档', async () => {
+    const { router, history } = await harness()
+    await router.push('/media/1')
+    await router.replace('/media/2')
+    expect(history.navigation).toEqual({ rootId: '/dashboard', canGoBack: true, backTarget: '/dashboard' })
+    await navigateOnce(router, () => router.back())
+    expect(history.navigation.canGoBack).toBe(false)
+    await router.push('/media/3')
+    expect(history.selectRoot('/apps')).toBe(true)
+    await flushPromises()
+    expect(router.currentRoute.value.fullPath).toBe('/apps')
+    expect(history.selectRoot('/dashboard')).toBe(true)
+    await flushPromises()
+    expect(router.currentRoute.value.fullPath).toBe('/media/3')
+    expect(history.navigation.backTarget).toBe('/dashboard')
+    expect(history.back(document, window)).toBe(true)
+    await flushPromises()
+    expect(router.currentRoute.value.fullPath).toBe('/dashboard')
+  })
+
+  it('守卫取消不会提前改变选中入口或返回栈', async () => {
+    const { router, history } = await harness()
+    router.beforeEach(to => to.path !== '/apps')
+    history.selectRoot('/apps')
+    await flushPromises()
+    expect(router.currentRoute.value.path).toBe('/dashboard')
+    expect(history.navigation.rootId).toBe('/dashboard')
+    expect(history.navigation.canGoBack).toBe(false)
+  })
+
+  it('顶层 HTML 弹层或输入框优先消费返回，不改变业务路由', async () => {
+    const { router, history } = await harness()
+    await router.push('/media/1')
+    const overlay = document.createElement('div')
+    overlay.className = 'v-overlay--active'
+    document.body.append(overlay)
+    expect(history.back(document, window)).toBe(true)
+    expect(router.currentRoute.value.path).toBe('/media/1')
+    overlay.remove()
+    const input = document.createElement('input')
+    document.body.append(input)
+    input.focus()
+    expect(history.back(document, window)).toBe(true)
+    expect(document.activeElement).not.toBe(input)
+    expect(router.currentRoute.value.path).toBe('/media/1')
+    input.remove()
+  })
+})
