--- /dev/null
+++ b/src/native/header.ts
@@ -0,0 +1,36 @@
+import type { NativeSnapshot } from './protocol'
+
+/** 将业务分类值映射为当前 owner 的稳定短标识，中文和任意业务值都留在网页内。 */
+export class NativeHeaderTabs {
+  private owner: string | undefined
+  private sequence = 0
+  private identifiers = new Map<string, string>()
+
+  /** 同 owner 重排保留标识；移除后不复用旧标识，避免旧菜单点击另一个分类。 */
+  project(ownerId: string, items: Array<{ tab: string; title: string }>, selected: string) {
+    if (!items.length || items.length > 32 || new Set(items.map(item => item.tab)).size !== items.length)
+      throw new Error('unsupported_header_registration')
+    // 旧页面在 mounted 中设置默认分类；此前暂不呈现选择器，不能替业务抢选或终止整个接管。
+    if (!items.some(item => item.tab === selected)) return undefined
+    if (this.owner !== ownerId) {
+      this.owner = ownerId
+      this.sequence = 0
+      this.identifiers.clear()
+    }
+    const current = new Set(items.map(item => item.tab))
+    for (const value of this.identifiers.keys()) if (!current.has(value)) this.identifiers.delete(value)
+    for (const item of items)
+      if (!this.identifiers.has(item.tab)) this.identifiers.set(item.tab, `tab-${++this.sequence}`)
+    return {
+      ownerId,
+      selectedId: this.identifiers.get(selected)!,
+      items: items.map(item => ({ id: this.identifiers.get(item.tab)!, title: item.title })),
+    } satisfies NonNullable<NativeSnapshot['headerTabs']>
+  }
+
+  /** 只解析当前 owner 的现存标识，过期或已失去权限的分类不能执行。 */
+  resolve(ownerId: string, id: string) {
+    if (ownerId !== this.owner) return undefined
+    return [...this.identifiers].find(([, identifier]) => identifier === id)?.[0]
+  }
+}
diff --git a/src/native/history.ts b/src/native/history.ts
new file mode 100644
index 00000000..7c90a96f
--- /dev/null
+++ b/src/native/history.ts
@@ -0,0 +1,144 @@
+import { shallowRef } from 'vue'
+import type { Router } from 'vue-router'
+import { isNativeRoute, type NativeSnapshot } from './protocol'
+import { readNativePresentation } from './presentation'
+
+/** 每个入口的逻辑路径由网页 Router 完成钩子维护，原生不保存第二份业务栈。
+ */
+export class NativeRouteHistory {
+  readonly revision = shallowRef(0)
+  private readonly trails = new Map<string, string[]>()
+  private currentRoot: string | null = null
+  private lastPosition?: number
+  private intent?: { target: string; kind: 'root' | 'back'; rootId: string }
+  private readonly removeHook: () => void
+
+  /** 使用当前 Vue Router 的公开 history.state.position 识别 push/replace/pop，并以实际成功路由为准。
+   */
+  constructor(
+    private readonly router: Router,
+    private readonly roots: () => NativeSnapshot['roots'],
+  ) {
+    this.record()
+    this.removeHook = router.afterEach((_to, _from, failure) => {
+      if (!failure) this.record()
+    })
+  }
+
+  /** 身份或权限代次变化立即撤销旧动作和路径缓存。
+   */
+  reset() {
+    this.trails.clear()
+    this.currentRoot = null
+    this.lastPosition = undefined
+    this.intent = undefined
+    this.record()
+  }
+
+  /** 读取已确认的根入口与返回目标；直接深链接也能回到所属入口。
+   */
+  get navigation() {
+    const trail = this.currentRoot ? this.trails.get(this.currentRoot) : undefined
+    const backTarget = trail && trail.length > 1 ? trail[trail.length - 2] : undefined
+    return { rootId: this.currentRoot, canGoBack: Boolean(backTarget), ...(backTarget ? { backTarget } : {}) }
+  }
+
+  /** Tab 使用 replace 恢复该入口最后位置，取消守卫不会提前改变栈或选中项。
+   */
+  selectRoot(id: string) {
+    const root = this.roots().find(item => item.id === id)
+    if (!root || this.intent) return false
+    // “更多”是目录入口，每次点击都回到目录，其他 Tab 保留最近业务位置。
+    const target = root.path === '/apps' ? root.path : (this.trails.get(id)?.at(-1) ?? root.path)
+    this.navigate(target, 'root', id)
+    return true
+  }
+
+  /** 先结束键盘编辑或交给当前 HTML 弹层处理返回，再请求 Router 通过业务守卫。
+   */
+  back(document: Document, targetWindow: Window) {
+    const focused = document.activeElement
+    if (focused instanceof HTMLElement && focused.matches('input,textarea,[contenteditable="true"]')) {
+      focused.blur()
+      return true
+    }
+    if (readNativePresentation(document).overlayOpen) {
+      targetWindow.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', code: 'Escape', bubbles: true }))
+      return true
+    }
+    const target = this.navigation.backTarget
+    if (!target || !this.currentRoot || this.intent) return false
+    this.navigate(target, 'back', this.currentRoot)
+    return true
+  }
+
+  /** 宿主卸载后清理钩子，避免重复记录一次路由。
+   */
+  stop() {
+    this.removeHook()
+    this.trails.clear()
+  }
+
+  /** 只为一次当前意图保留关联；确认后才处理路径栈，失败不重放。
+   */
+  private navigate(target: string, kind: 'root' | 'back', rootId: string) {
+    if (!isNativeRoute(target)) return
+    const intent = { target, kind, rootId }
+    this.intent = intent
+    void this.router
+      .replace(target)
+      .finally(() => {
+        if (this.intent === intent) this.intent = undefined
+      })
+      .catch(() => {
+        /* Router 保留当前已确认页面，失败意图不重放。 */
+      })
+  }
+
+  /** 匹配实际入口；详情页沿用来源入口，普通业务页面归属更多。
+   */
+  private rootFor(path: string) {
+    const roots = this.roots()
+    if (!this.router.currentRoute.value.meta.requiresAuth) return null
+    const explicit = roots.find(root => path === root.path || path.startsWith(`${root.path}/`))
+    if (explicit) return explicit.id
+    if (/^\/(media|person|browse|credits)(\/|$)/.test(path) && roots.some(root => root.id === this.currentRoot))
+      return this.currentRoot
+    return roots.find(root => root.path === '/apps')?.id ?? roots[0]?.id ?? null
+  }
+
+  /** 完成钩子同时覆盖页面自身导航、外部 hash 和原生意图；失败钩子不写入。
+   */
+  private record() {
+    const route = this.router.currentRoute.value
+    const position = this.router.options.history.state.position
+    const numericPosition = typeof position === 'number' ? position : undefined
+    const intent = this.intent?.target === route.fullPath ? this.intent : undefined
+    const rootId = intent?.rootId ?? this.rootFor(route.path)
+    if (rootId) {
+      const root = this.roots().find(item => item.id === rootId)
+      let trail = this.trails.get(rootId) ?? (root && route.fullPath !== root.path ? [root.path] : [])
+      if (intent?.kind === 'back') {
+        const index = trail.lastIndexOf(route.fullPath)
+        trail = index >= 0 ? trail.slice(0, index + 1) : [...trail, route.fullPath]
+      } else if (intent?.kind !== 'root') {
+        const index = trail.lastIndexOf(route.fullPath)
+        if (
+          numericPosition !== undefined &&
+          this.lastPosition !== undefined &&
+          numericPosition < this.lastPosition &&
+          index >= 0
+        )
+          trail = trail.slice(0, index + 1)
+        else if (numericPosition === this.lastPosition && rootId === this.currentRoot && trail.length)
+          trail = [...trail.slice(0, -1), route.fullPath]
+        else if (trail.at(-1) !== route.fullPath) trail = [...trail, route.fullPath]
+      } else if (root?.path === '/apps' && route.fullPath === root.path) trail = [root.path]
+      else if (!trail.length) trail = [route.fullPath]
+      this.trails.set(rootId, trail.slice(-128))
+    }
+    this.currentRoot = rootId
+    this.lastPosition = numericPosition
+    this.revision.value += 1
+  }
+}
diff --git a/src/native/layout.ts b/src/native/layout.ts
new file mode 100644
index 00000000..98648450
--- /dev/null
+++ b/src/native/layout.ts
@@ -0,0 +1,134 @@
+import { readonly, ref } from 'vue'
+import { isRecord, type NativeLayout } from './protocol'
+
+const active = ref(false)
+const insets = ref({ top: 0, left: 0, bottom: 0, right: 0 })
+/** 只有事务提交后才为 true；普通网页不依赖 UA 或查询参数改变布局。 */
+export const nativeChromeActive = readonly(active)
+/** 正文、固定浮层与菜单共用的 CSS 边距，已经包含导航和系统安全区。 */
+export const nativeContentInsets = readonly(insets)
+
+/** 对一份受控文档管理接管布局与不可见菜单锚点。 */
+export class NativeLayoutAdapter {
+  private revision = -1
+  private scale = 1
+  private readonly anchors = new Map<string, HTMLElement>()
+
+  /** 文档和 viewport 显式传入，测试不依赖设备像素密度。 */
+  constructor(
+    private readonly document: Document,
+    private readonly viewport: Window,
+  ) {}
+
+  /** 消费原生 point 量测；不叠加 env safe area 或旧网页 Dock 高度。 */
+  apply(payload: Record<string, unknown>) {
+    if (
+      !Number.isSafeInteger(payload.layoutRevision) ||
+      !isRecord(payload.viewportPoints) ||
+      !this.validInsets(payload.contentInsets) ||
+      !this.validInsets(payload.systemSafeArea) ||
+      !this.validInsets(payload.chromeOcclusion) ||
+      typeof payload.consumedByNativeFrame !== 'boolean' ||
+      typeof payload.keyboardOcclusion !== 'number' ||
+      !Number.isFinite(payload.keyboardOcclusion) ||
+      payload.keyboardOcclusion < 0
+    )
+      throw new Error('invalid_layout')
+    const layout = payload as unknown as NativeLayout
+    if (layout.layoutRevision < this.revision) return
+    const { width, height } = layout.viewportPoints
+    if (
+      ![width, height].every(
+        value => typeof value === 'number' && Number.isFinite(value) && value > 0 && value <= 10000,
+      )
+    )
+      throw new Error('invalid_layout')
+    this.revision = layout.layoutRevision
+    this.scale = this.viewport.innerWidth / width
+    const values = layout.consumedByNativeFrame ? { top: 0, left: 0, bottom: 0, right: 0 } : layout.contentInsets
+    insets.value = Object.fromEntries(
+      Object.entries(values).map(([edge, value]) => [edge, value * this.scale]),
+    ) as typeof insets.value
+    for (const [edge, value] of Object.entries(insets.value))
+      this.document.documentElement.style.setProperty(`--native-${edge}`, `${value}px`)
+    // WebKit 的 VisualViewport 已负责键盘缩放；这里只记录原生遮挡，不再扣一次高度。
+    this.document.documentElement.style.setProperty(
+      '--native-keyboard-occlusion',
+      `${layout.keyboardOcclusion * this.scale}px`,
+    )
+  }
+
+  /** 改变 DOM 模式只允许由桥接事务调用，释放时清理所有兼容锚点。 */
+  setActive(value: boolean) {
+    active.value = value
+    if (value) this.document.documentElement.dataset.nativeChrome = 'active'
+    else {
+      delete this.document.documentElement.dataset.nativeChrome
+      insets.value = { top: 0, left: 0, bottom: 0, right: 0 }
+      for (const edge of ['top', 'left', 'bottom', 'right', 'keyboard-occlusion'])
+        this.document.documentElement.style.removeProperty(`--native-${edge}`)
+      for (const anchor of this.anchors.values()) anchor.remove()
+      this.anchors.clear()
+      this.revision = -1
+    }
+  }
+
+  /** 保留当前动作需要的可量测 DOM 锚点，注销后立即删除旧 owner 的锚点。 */
+  syncAnchors(attributes: string[]) {
+    const current = new Set(attributes)
+    for (const [key, anchor] of this.anchors) {
+      if (!current.has(key)) {
+        anchor.remove()
+        this.anchors.delete(key)
+      }
+    }
+    for (const attribute of attributes) {
+      if (!/^[a-zA-Z0-9_-]{1,128}$/.test(attribute)) throw new Error('invalid_anchor')
+      if (this.anchors.has(attribute)) continue
+      const anchor = this.document.createElement('span')
+      anchor.dataset.menuActivator = attribute
+      anchor.dataset.nativeMenuAnchor = ''
+      // Vuetify 用 aria-owns 将弹层归属到锚点；隐藏或 inert 会让 WebKit 连带移除整份菜单。
+      // 空的展示节点本身不绘制内容、不参与顺序焦点，也不接收触控，但其菜单仍须可访问。
+      anchor.setAttribute('role', 'presentation')
+      anchor.style.cssText = 'position:fixed;pointer-events:none;width:1px;height:1px;'
+      anchor.style.left = `${Math.max(0, this.viewport.innerWidth - 48 - insets.value.right)}px`
+      anchor.style.top = `${insets.value.top}px`
+      this.document.body.append(anchor)
+      this.anchors.set(attribute, anchor)
+    }
+  }
+
+  /** 将被点击原生控件的位置转换为 CSS 像素，并限制整个锚点在 viewport 范围。
+   * 旧量测不用于新旋转布局，防止菜单锚定到屏幕外。
+   */
+  positionAnchor(attribute: string, frame: unknown, layoutRevision: unknown) {
+    const anchor = this.anchors.get(attribute)
+    if (!anchor || !isRecord(frame) || layoutRevision !== this.revision) return
+    const values = ['x', 'y', 'width', 'height'].map(key => frame[key])
+    if (!values.every(value => typeof value === 'number' && Number.isFinite(value))) return
+    const [x, y, width, height] = values as number[]
+    const anchorWidth = Math.max(1, Math.min(44, width * this.scale))
+    const anchorHeight = Math.max(1, Math.min(44, height * this.scale))
+    const maxX = Math.max(insets.value.left, this.viewport.innerWidth - insets.value.right - anchorWidth)
+    const maxY = Math.max(0, this.viewport.innerHeight - insets.value.bottom - anchorHeight)
+    Object.assign(anchor.style, {
+      left: `${Math.min(maxX, Math.max(insets.value.left, x * this.scale))}px`,
+      top: `${Math.min(maxY, Math.max(0, y * this.scale))}px`,
+      width: `${anchorWidth}px`,
+      height: `${anchorHeight}px`,
+    })
+  }
+
+  /** 非负、有限边距才可进入 CSS，拒绝 NaN 与恶意超大占位。
+   */
+  private validInsets(value: unknown): value is NativeLayout['contentInsets'] {
+    return (
+      isRecord(value) &&
+      ['top', 'left', 'bottom', 'right'].every(
+        edge =>
+          typeof value[edge] === 'number' && Number.isFinite(value[edge]) && value[edge] >= 0 && value[edge] <= 10000,
+      )
+    )
+  }
+}
diff --git a/src/native/native.scss b/src/native/native.scss
new file mode 100644
index 00000000..d3cb602e
--- /dev/null
+++ b/src/native/native.scss
@@ -0,0 +1,218 @@
+// 只有双方事务提交后的文档才采用此布局；普通网页/PWA 不匹配选择器。
+html[data-native-chrome='active'] {
+  scroll-padding-block: var(--native-top) var(--native-bottom);
+
+  // 页面级标题与附属操作由系统顶栏承载；业务卡片、章节和弹窗标题不属于此选择器。
+  [data-native-page-title],
+  [data-native-page-heading],
+  [data-native-page-actions] {
+    display: none !important;
+  }
+
+  .layout-navbar {
+    visibility: hidden !important;
+    pointer-events: none !important;
+    block-size: 0 !important;
+    overflow: hidden !important;
+  }
+
+  .layout-vertical-nav,
+  .layout-overlay {
+    display: none !important;
+  }
+
+  .layout-content-wrapper {
+    padding-inline-start: 0 !important;
+  }
+
+  .layout-page-content {
+    // 系统栏下面保留正文呼吸空间，不改变菜单锚点或全屏弹窗的安全区原点。
+    padding-block-start: calc(var(--native-top) + 12px) !important;
+    padding-block-end: var(--native-bottom) !important;
+    // UIKit 上报的是物理左右边距；保留对称网页留白，避免缺口或系统侧栏遮挡正文。
+    padding-left: calc(var(--native-left) + 0.5rem) !important;
+    padding-right: calc(var(--native-right) + 0.5rem) !important;
+  }
+
+  .page-content-container > div:first-child {
+    // 旧网页的 viewport 宽度没有扣除系统侧栏，改为消费上层已经计算的可见宽度。
+    inline-size: 100% !important;
+    min-inline-size: 0;
+  }
+
+  .main-content-wrapper {
+    padding-block-start: 0 !important;
+  }
+
+  .footer-content-container {
+    block-size: 0 !important;
+    min-block-size: 0 !important;
+  }
+
+  // 普通菜单/弹窗保留底栏，只有全屏弹窗延伸到 Home Indicator 区域。
+  .v-dialog {
+    inset-block: var(--native-top) var(--native-bottom) !important;
+    inset-inline: var(--native-left) var(--native-right) !important;
+  }
+
+  .v-dialog > .v-overlay__content,
+  .v-menu > .v-overlay__content {
+    margin-block: 0 !important;
+  }
+
+  .v-dialog > .v-overlay__content {
+    max-block-size: 100%;
+  }
+
+  .v-dialog--fullscreen > .v-overlay__content {
+    block-size: 100%;
+  }
+
+  .v-dialog--fullscreen {
+    inset-block-end: 0 !important;
+  }
+
+  // 弹窗之外降低亮度并显著模糊，保留弹窗自身文字和控件的清晰度。
+  .v-dialog > .v-overlay__scrim,
+  .v-menu > .v-overlay__scrim {
+    background: rgba(var(--v-theme-background), 0.74) !important;
+    opacity: 1 !important;
+    backdrop-filter: blur(22px) saturate(0.75);
+    -webkit-backdrop-filter: blur(22px) saturate(0.75);
+  }
+
+  .medal-showcase .medal-showcase__close {
+    // 以已避开原生顶栏的弹窗为定位参考，避免再按整个屏幕偏移。
+    position: absolute;
+    inset-block-start: 12px;
+    inset-inline-end: 12px;
+  }
+
+  .theme-customizer-panel-host[role='dialog'] {
+    inset-block-start: var(--native-top) !important;
+    block-size: calc(100dvh - var(--native-top)) !important;
+    min-block-size: 0 !important;
+    inline-size: 100% !important;
+    padding-block-end: var(--native-bottom);
+  }
+
+  .theme-customizer-panel--dialog {
+    // 状态栏已计入原生顶边距，定制器内部不再重复添加安全区。
+    padding-block-start: 0;
+  }
+
+  .v-dialog--fullscreen > .v-overlay__content > .v-card,
+  .v-bottom-sheet > .v-bottom-sheet__content.v-overlay__content > .v-card {
+    padding-block-end: var(--native-bottom);
+  }
+}
+
+// 仅在原生明确请求时短暂显示原底页，供单 WebView 搬入 Sheet 时保留上下文。
+html[data-native-chrome='active'][data-native-sheet-preparing] {
+  .v-overlay--active.v-dialog,
+  .theme-customizer-panel-host[role='dialog'],
+  .agent-assistant-panel.is-open[role='dialog'],
+  .agent-assistant-fab,
+  .agent-pet-stage-layer {
+    visibility: hidden !important;
+    opacity: 0 !important;
+  }
+}
+
+// 同一 WebView 进入系统 Sheet 后只显示当前 Vue 弹窗的内容；普通浏览器完全不匹配。
+html[data-native-chrome='active'][data-native-sheet] {
+  &,
+  body,
+  #app,
+  .v-application,
+  .v-application__wrap {
+    background: transparent !important;
+  }
+
+  #app {
+    visibility: hidden;
+  }
+
+  // 浮动助手入口不属于当前业务弹窗，不能盖在原生 Sheet 的内容或底部操作上。
+  .agent-assistant-fab,
+  .agent-pet-stage-layer {
+    display: none !important;
+  }
+
+  .v-overlay-container {
+    visibility: visible;
+  }
+
+  .v-dialog:not([data-native-sheet-current]),
+  .theme-customizer-panel-host:not([data-native-sheet-current]),
+  .agent-assistant-panel:not([data-native-sheet-current]) {
+    visibility: hidden !important;
+  }
+
+  [data-native-sheet-current] {
+    visibility: visible !important;
+    position: fixed !important;
+    inset: 0 !important;
+    inline-size: 100% !important;
+    block-size: 100% !important;
+    min-block-size: 0 !important;
+    padding: 0 !important;
+    background: transparent !important;
+    transition: none !important;
+
+    > .v-overlay__scrim,
+    [data-native-sheet-header],
+    [data-native-sheet-heading],
+    [data-native-dialog-close],
+    .medal-showcase__veil {
+      display: none !important;
+    }
+
+    > .v-overlay__content {
+      position: absolute !important;
+      inset: 0 !important;
+      inline-size: 100% !important;
+      block-size: 100% !important;
+      min-block-size: 0 !important;
+      max-inline-size: none !important;
+      max-block-size: none !important;
+      margin: 0 !important;
+      transform: none !important;
+      transition: none !important;
+    }
+
+    > .v-overlay__content > .v-card,
+    > .v-overlay__content > .medal-showcase,
+    > .theme-customizer-panel,
+    > .agent-assistant-shell {
+      inline-size: 100% !important;
+      block-size: 100% !important;
+      min-block-size: 0 !important;
+      max-block-size: none !important;
+      border: 0 !important;
+      border-radius: 0 !important;
+      box-shadow: none !important;
+      background: transparent !important;
+      backdrop-filter: none !important;
+      -webkit-backdrop-filter: none !important;
+      padding-block: 0 !important;
+    }
+
+    .agent-assistant-header {
+      justify-content: flex-end;
+      padding-block: 8px;
+      border: 0;
+    }
+
+    > .v-overlay__content > .v-card::before,
+    > .v-overlay__content > .v-card::after,
+    > .theme-customizer-panel::before,
+    > .theme-customizer-panel::after {
+      display: none !important;
+    }
+
+    > .theme-customizer-panel > .v-divider {
+      display: none;
+    }
+  }
+}
