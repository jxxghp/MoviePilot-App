+    const current = projectNativePanel(source)
+    expect(current.panel.sections[0].items[0].children?.map(row => row.primary)).toEqual([true, undefined])
+    expect(dispatchNativePanel(current, { panelEvent: 'select', itemId: 'run' })).toBe(true)
+    source.sections[0].items[0].children![0].enabled = false
+    expect(dispatchNativePanel(projectNativePanel(source), { panelEvent: 'select', itemId: 'run' })).toBe(false)
+    expect(invoke).toHaveBeenCalledOnce()
+  })
+
+  it('账号摘要保留有界昵称、身份和缩略图，拒绝内联文档、凭据 URL 和超大头像', () => {
+    const images = [
+      'data:image/jpeg;base64,/9j/2Q==',
+      'https://image.example/avatar.png',
+      'data:image/svg+xml,<svg/>',
+      'data:image/jpeg;base64,' + 'a'.repeat(8192),
+      'https://user:pass@example/avatar.png',
+    ]
+    for (const [index, image] of images.entries()) {
+      const { panel } = projectNativePanel({
+        title: '用户菜单',
+        profile: { name: '当前\n用户', detail: '管理员', image },
+        sections: [],
+      })
+      expect(panel.profile?.name).toBe('当前 用户')
+      expect(panel.profile?.detail).toBe('管理员')
+      expect(panel.profile?.image).toBe(index < 2 ? image : undefined)
+    }
+  })
+
+  it('只序列化有界展示数据，不把回调或控制字符交给原生', () => {
+    const invoke = vi.fn()
+    const { panel, callbacks } = projectNativePanel({
+      title: '消息中心',
+      sections: [
+        {
+          id: 'messages',
+          items: Array.from({ length: 200 }, (_, index) => ({
+            id: `message-${index}`,
+            title: '通知\n标题',
+            subtitle: '长正文'.repeat(3000),
+            invoke,
+          })),
