{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoviePilot Native Plugin Host Bridge Protocol v2",
  "protocol": "moviepilot.pluginHost",
  "major": 2,
  "virtualOrigins": {
    "ios": "mp-plugin://shell",
    "android": "https://plugin-shell.moviepilot.local",
    "harmony": "https://plugin-shell.moviepilot.local"
  },
  "virtualRoutes": {
    "shellPrefix": "/shell/",
    "shellEntry": "/shell/plugin-shell.html",
    "remotePrefix": "/plugin-remote/{pluginId}/{versionOrHash}/{assetPath}",
    "passiveApiPrefix": "/api/v1/"
  },
  "securityInvariants": [
    "No Bearer token, session secret, or localStorage.auth is ever written into the WebView.",
    "All authenticated plugin API requests traverse bridge message api.request with payload.requestId and are validated to strictly target /api/v1/ on the active MoviePilot instance.",
    "Remote plugin JS/CSS chunks are served through the platform virtual origin and disk-cached under {instanceHash}/{pluginId}/{versionOrHash}/.",
    "Passive GET /api/v1/ requests (images, icons, plugin static assets) are intercepted and authenticated natively without exposing tokens to JS.",
    "Native device/media capabilities enforce OS runtime permissions, cap returned base64 payloads at 15 MiB, and release active recordings, inline audio players, and keep-awake locks on plugin.unmount or WebView release."
  ],
  "hostToWebTypes": [
    "plugin.mount",
    "plugin.unmount",
    "theme.update",
    "locale.update",
    "safeArea.update",
    "nav.back",
    "host.action",
    "capsule.action",
    "bridge.response",
    "device.event"
  ],
  "webToHostTypes": [
    "shell.ready",
    "plugin.mounted",
    "plugin.error",
    "plugin.close",
    "plugin.minimize",
    "plugin.capsule.update",
    "plugin.restore",
    "plugin.action",
    "api.request",
    "api.abort",
    "ui.toast",
    "ui.confirm",
    "ui.header",
    "nav.backResult",
    "nav.openRoute",
    "nav.openExternal",
    "device.capabilities",
    "device.info",
    "device.permission",
    "device.haptic",
    "device.clipboard",
    "device.clipboard.read",
    "device.share",
    "device.keepAwake",
    "device.notify",
    "device.pickMedia",
    "device.pickFile",
    "device.saveMedia",
    "device.scanCode",
    "device.authenticate",
    "audio.record.start",
    "audio.record.pause",
    "audio.record.resume",
    "audio.record.stop",
    "audio.record.cancel",
    "audio.record.status",
    "audio.play",
    "audio.pause",
    "audio.resume",
    "audio.stop",
    "audio.seek",
    "audio.setRate",
    "audio.setVolume",
    "audio.getSystemVolume",
    "audio.setSystemVolume",
    "audio.setSpectrum",
    "audio.status",
    "audio.setNowPlaying",
    "audio.clearNowPlaying",
    "media.playNative",
    "widget.update",
    "widget.remove",
    "widget.list"
  ],
  "deviceEventNames": [
    "audio.record.state",
    "audio.record.level",
    "audio.play.state",
    "audio.play.progress",
    "audio.play.spectrum",
    "audio.play.ended",
    "audio.play.error",
    "audio.remoteCommand",
    "audio.systemVolume",
    "capsule.action",
    "capsule.state",
    "widget.action"
  ],
  "visualTokens": {
    "requiredFields": [
      "mode",
      "platform",
      "backgroundPreset",
      "isAmoledBlack",
      "highContrast",
      "accentHex",
      "onAccentHex",
      "textPrimaryHex",
      "textSecondaryHex",
      "surfaceGlassRgba",
      "surfaceElevatedRgba",
      "surfaceBorderRgba",
      "surfaceBlurPx",
      "solidSurfaceHex",
      "fieldFillRgba",
      "fieldBorderRgba",
      "chipFillRgba",
      "chipBorderRgba",
      "dividerRgba",
      "panelRadiusPx",
      "sheetRadiusPx",
      "borderWidthPx",
      "semantic"
    ]
  },
  "poolPolicy": {
    "warmIdleCount": 1,
    "prewarmIdleDelayMs": 1500,
    "maxReusesPerWebView": 15,
    "remoteDiskCacheLimitBytes": 52428800,
    "mountFadeInMs": 160
  }
}
