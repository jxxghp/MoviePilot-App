<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- MoviePilot 自托管 NAS 广泛使用局域网 HTTP 与自签名 HTTPS 证书，允许局域网明文并信任用户证书 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
