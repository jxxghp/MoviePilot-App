<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>MoviePilot</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundleDevelopmentRegion</key><string>zh_CN</string>
  <key>CFBundleLocalizations</key><array><string>zh-Hans</string></array>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>MoviePilotAPNsEnvironment</key><string>$(MOVIEPILOT_APNS_ENVIRONMENT)</string>
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleURLName</key><string>org.moviepilot.app.notification</string>
    <key>CFBundleURLSchemes</key><array><string>moviepilot-app</string></array>
  </dict><dict>
    <key>CFBundleURLName</key><string>org.moviepilot.app.widget</string>
    <key>CFBundleURLSchemes</key><array><string>moviepilot</string></array>
  </dict></array>
  <key>MoviePilotWidgetsEnabled</key><true/>
  <key>UIApplicationShortcutItems</key><array>
    <dict>
      <key>UIApplicationShortcutItemType</key><string>org.moviepilot.app.search</string>
      <key>UIApplicationShortcutItemTitle</key><string>搜索</string>
      <key>UIApplicationShortcutItemIconSymbolName</key><string>magnifyingglass</string>
    </dict>
    <dict>
      <key>UIApplicationShortcutItemType</key><string>org.moviepilot.app.notifications</string>
      <key>UIApplicationShortcutItemTitle</key><string>通知中心</string>
      <key>UIApplicationShortcutItemIconSymbolName</key><string>bell</string>
    </dict>
    <dict>
      <key>UIApplicationShortcutItemType</key><string>org.moviepilot.app.plugins</string>
      <key>UIApplicationShortcutItemTitle</key><string>插件面板</string>
      <key>UIApplicationShortcutItemIconSymbolName</key><string>puzzlepiece.extension</string>
    </dict>
  </array>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>UILaunchStoryboardName</key><string>LaunchScreen</string>
  <key>UIApplicationSceneManifest</key><dict>
    <key>UIApplicationSupportsMultipleScenes</key><false/>
    <key>UISceneConfigurations</key><dict>
      <key>UIWindowSceneSessionRoleApplication</key><array><dict>
        <key>UISceneConfigurationName</key><string>Default Configuration</string>
        <key>UISceneDelegateClassName</key><string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
      </dict></array>
    </dict>
  </dict>
  <key>UISupportedInterfaceOrientations</key><array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key><array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>NSLocalNetworkUsageDescription</key><string>连接你在局域网中配置的 MoviePilot 服务。</string>
  <key>NSCameraUsageDescription</key><string>在 MoviePilot 网页中选择拍照上传时使用相机。</string>
  <key>NSMicrophoneUsageDescription</key><string>在智能助手中录制并发送语音消息时使用麦克风。</string>
  <key>NSPhotoLibraryUsageDescription</key><string>在 MoviePilot 网页中选择要上传的照片。</string>
  <key>NSPhotoLibraryAddUsageDescription</key><string>将你选择保存的智能助手图片存入照片图库。</string>
  <key>NSAppTransportSecurity</key><dict>
    <!-- 用户可配置任意 HTTP 实例；本地或 WebContent 例外会覆盖此全局设置。 -->
    <key>NSAllowsArbitraryLoads</key><true/>
  </dict>
</dict></plist>
